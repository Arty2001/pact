{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pact",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Static assets are served first. Anything that is not a file on disk
  // (i.e. every /api/* path) falls through to the Worker in src/index.ts.
  "assets": {
    "directory": "./public"
  },

  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "Hub" },
      { "name": "ENGINE", "class_name": "Engine" }
    ]
  },
  // Each new class needs its own tag. v1 is already applied in production,
  // so editing it would be a no-op at best and a rejected deploy at worst.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub"] },
    { "tag": "v2", "new_sqlite_classes": ["Engine"] }
  ],

  "routes": [
    { "pattern": "pact.lanvar.ai", "custom_domain": true }
  ]
}
